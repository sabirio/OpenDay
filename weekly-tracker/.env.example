# ── Supabase (required for all environments) ──────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Migration scripts only — never exposed to the browser ─────────────────────
# Required only when running src/migrations/backfillProgressHistory.js locally.
# Never prefix with VITE_ — Vite intentionally excludes non-VITE_ vars from the
# browser bundle, so this key never reaches the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── E2E / Playwright ──────────────────────────────────────────────────────────
# Dedicated anon/publishable key for E2E seeds (optional — falls back to VITE_SUPABASE_ANON_KEY).
# Set this in CI to avoid exposing VITE_ vars to the test runner environment.
E2E_SUPABASE_ANON_KEY=

# Test account credentials — override if your test users differ from the defaults.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PM_EMAIL=
E2E_PM_PASSWORD=
E2E_CONTRACTOR_EMAIL=
E2E_CONTRACTOR_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=

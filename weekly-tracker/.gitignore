# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Test / report output artifacts — never track
test-results
playwright-report
scripts/storage/audit-log
scripts/staging/staging-fixture-state.json
.env
.env.*
!.env.example

# Prevent accidental commit of archives that may contain secrets
*.zip

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env.local

# External tooling (e.g. skill scripts) that can get materialized into the
# project root by the dev environment — not part of this app's source
.agents

# Vercel CLI local project link metadata — project/org IDs, not secrets, but
# machine-local and never meant to be committed (standard Vercel default).
.vercel
